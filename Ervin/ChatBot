<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeuroChat - Trainable AI</title>
    <style>
        /* CSS Variables for Theming */
        :root {
            --primary-color: #3b82f6;
            --primary-hover: #2563eb;
            --bg-color: #f3f4f6;
            --chat-bg: #ffffff;
            --text-color: #1f2937;
            --text-secondary: #6b7280;
            --border-color: #e5e7eb;
            --user-bubble-bg: #3b82f6;
            --user-bubble-text: #ffffff;
            --bot-bubble-bg: #f3f4f6;
            --bot-bubble-text: #1f2937;
            --danger-color: #ef4444;
            --success-color: #10b981;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --radius: 12px;
            --transition: 0.3s ease;
        }

        /* Dark Theme Variables */
        [data-theme="dark"] {
            --bg-color: #111827;
            --chat-bg: #1f2937;
            --text-color: #f9fafb;
            --text-secondary: #9ca3af;
            --border-color: #374151;
            --bot-bubble-bg: #374151;
            --bot-bubble-text: #f9fafb;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            transition: background-color var(--transition), color var(--transition);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Header */
        header {
            background-color: var(--chat-bg);
            padding: 1rem 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow);
            z-index: 10;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .bot-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary-color), #8b5cf6);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .bot-info h1 {
            font-size: 1.1rem;
            font-weight: 600;
        }

        .bot-status {
            font-size: 0.8rem;
            color: var(--success-color);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .bot-status::before {
            content: '';
            width: 8px;
            height: 8px;
            background-color: var(--success-color);
            border-radius: 50%;
            display: inline-block;
        }

        .header-actions {
            display: flex;
            gap: 0.5rem;
        }

        /* Buttons & Inputs */
        button {
            cursor: pointer;
            padding: 0.5rem 1rem;
            border: none;
            border-radius: var(--radius);
            font-size: 0.9rem;
            font-weight: 500;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-primary {
            background-color: var(--primary-color);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .btn-secondary {
            background-color: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-color);
        }

        .btn-secondary:hover {
            background-color: var(--border-color);
        }

        .btn-icon {
            padding: 0.5rem;
            border-radius: 50%;
        }

        input, textarea {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            background-color: var(--bg-color);
            color: var(--text-color);
            font-size: 1rem;
            outline: none;
            transition: var(--transition);
        }

        input:focus, textarea:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        /* Chat Area */
        main {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            scroll-behavior: smooth;
        }

        .message {
            display: flex;
            align-items: flex-end;
            gap: 0.5rem;
            max-width: 80%;
            opacity: 0;
            transform: translateY(10px);
            animation: fadeIn 0.3s forwards;
        }

        @keyframes fadeIn {
            to { opacity: 1; transform: translateY(0); }
        }

        .message.user {
            align-self: flex-end;
            flex-direction: row-reverse;
        }

        .message.bot {
            align-self: flex-start;
        }

        .bubble {
            padding: 0.75rem 1rem;
            border-radius: var(--radius);
            position: relative;
            line-height: 1.5;
            font-size: 0.95rem;
        }

        .message.user .bubble {
            background-color: var(--user-bubble-bg);
            color: var(--user-bubble-text);
            border-bottom-right-radius: 2px;
        }

        .message.bot .bubble {
            background-color: var(--bot-bubble-bg);
            color: var(--bot-bubble-text);
            border-bottom-left-radius: 2px;
        }

        .meta {
            font-size: 0.7rem;
            color: var(--text-secondary);
            margin-top: 4px;
            text-align: right;
        }
        
        .confidence-badge {
            display: inline-block;
            font-size: 0.7rem;
            background: rgba(0,0,0,0.1);
            padding: 2px 6px;
            border-radius: 4px;
            margin-top: 5px;
            margin-left: 5px;
        }

        /* Input Area */
        footer {
            background-color: var(--chat-bg);
            padding: 1rem 1.5rem;
            border-top: 1px solid var(--border-color);
        }

        .input-container {
            display: flex;
            gap: 0.75rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Modal */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
            z-index: 100;
        }

        .modal-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        .modal {
            background-color: var(--chat-bg);
            width: 90%;
            max-width: 600px;
            border-radius: var(--radius);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            max-height: 85vh;
            transform: scale(0.95);
            transition: var(--transition);
        }

        .modal-overlay.active .modal {
            transform: scale(1);
        }

        .modal-header {
            padding: 1.25rem;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-body {
            padding: 1.25rem;
            overflow-y: auto;
        }

        .modal-footer {
            padding: 1.25rem;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: 0.5rem;
        }

        /* Training Data List */
        .training-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .training-item {
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 0.75rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: var(--bg-color);
        }

        .training-content {
            flex: 1;
            margin-right: 1rem;
        }

        .training-q {
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: var(--text-color);
        }

        .training-a {
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .item-actions {
            display: flex;
            gap: 0.25rem;
        }

        .btn-small {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
        }

        /* Typing Indicator */
        .typing-indicator {
            display: flex;
            gap: 4px;
            padding: 0.5rem;
        }
        
        .typing-dot {
            width: 6px;
            height: 6px;
            background-color: var(--text-secondary);
            border-radius: 50%;
            animation: bounce 1.4s infinite ease-in-out both;
        }
        
        .typing-dot:nth-child(1) { animation-delay: -0.32s; }
        .typing-dot:nth-child(2) { animation-delay: -0.16s; }
        
        @keyframes bounce {
            0%, 80%, 100% { transform: scale(0); }
            40% { transform: scale(1); }
        }

        /* Toast Notification */
        .toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 200;
        }

        .toast {
            background-color: var(--chat-bg);
            color: var(--text-color);
            padding: 1rem;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border-left: 4px solid var(--primary-color);
            animation: slideIn 0.3s ease-out;
            min-width: 250px;
        }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            margin-top: 2rem;
            color: var(--text-secondary);
        }

        /* Responsive */
        @media (max-width: 600px) {
            .header-left h1 { font-size: 1rem; }
            .header-actions span { display: none; } /* Hide button text on mobile */
            .modal { width: 100%; height: 100%; max-height: 100%; border-radius: 0; }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="header-left">
            <div class="bot-avatar" id="botAvatar">AI</div>
            <div class="bot-info">
                <h1 id="botNameDisplay">NeuroChat</h1>
                <div class="bot-status">Online</div>
            </div>
        </div>
        <div class="header-actions">
            <button class="btn-secondary btn-icon" id="themeToggle" title="Toggle Theme">
                ◑
            </button>
            <button class="btn-secondary" id="clearChatBtn">
                <span>Clear Chat</span>
            </button>
            <button class="btn-primary" id="openTrainBtn">
                <span>Train Bot</span>
            </button>
        </div>
    </header>

    <!-- Chat Area -->
    <main id="chatContainer">
        <!-- Messages will be injected here -->
        <div class="message bot">
            <div class="bot-avatar" style="width:30px; height:30px; font-size:0.8rem;">AI</div>
            <div class="bubble">
                Hello! I am a trainable bot. You can chat with me, or click "Train Bot" to teach me how to answer questions.
            </div>
        </div>
    </main>

    <!-- Input Area -->
    <footer>
        <div class="input-container">
            <input type="text" id="userInput" placeholder="Type a message..." autocomplete="off">
            <button class="btn-primary" id="sendBtn">Send</button>
        </div>
    </footer>

    <!-- Training Modal -->
    <div class="modal-overlay" id="trainModal">
        <div class="modal">
            <div class="modal-header">
                <h2>Training Dashboard</h2>
                <button class="btn-icon btn-secondary" id="closeTrainBtn">✕</button>
            </div>
            <div class="modal-body">
                <!-- Add New Pair -->
                <div style="margin-bottom: 1.5rem;">
                    <h3 style="margin-bottom:0.5rem; font-size:1rem;">Add Knowledge</h3>
                    <div style="display:flex; flex-direction:column; gap:0.5rem;">
                        <input type="text" id="trainQuestion" placeholder="User Question (e.g. 'What is your name?')">
                        <textarea id="trainAnswer" rows="2" placeholder="Bot Answer (e.g. 'I am NeuroChat.')"></textarea>
                        <button class="btn-primary" id="addPairBtn" style="justify-content:center;">Add Training Data</button>
                    </div>
                </div>

                <!-- Data List -->
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                    <h3 style="font-size:1rem;">Knowledge Base (<span id="knowledgeCount">0</span>)</h3>
                    <div style="display:flex; gap:0.5rem;">
                        <button class="btn-secondary btn-small" id="exportBtn">Export</button>
                        <label class="btn-secondary btn-small" style="cursor:pointer;">
                            Import
                            <input type="file" id="importFile" accept=".json" style="display:none;">
                        </label>
                    </div>
                </div>
                <div id="trainingList" class="training-list">
                    <!-- List items injected here -->
                    <div class="empty-state">No training data yet.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" id="closeTrainBtnFooter">Close</button>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script>
        /**
         * NeuroChat - Trainable Chatbot
         * 
         * Core Logic:
         * 1. State Management: Uses localStorage to persist training data (Q&A pairs).
         * 2. Matching Algorithm:
         *    - Step 1: Exact Match (Normalized).
         *    - Step 2: Keyword Similarity (Jaccard Index approach).
         *    - Step 3: Fallback if no match meets threshold.
         */

        // --- State Management ---
        const STORAGE_KEY = 'neurochat_data';
        const CHAT_KEY = 'neurochat_history';
        const THEME_KEY = 'neurochat_theme';
        
        // Default Data
        const defaultData = [
            { id: 1, question: 'hello', answer: 'Hi there! How can I help you today?' },
            { id: 2, question: 'who are you', answer: 'I am a trainable chatbot created by you.' },
            { id: 3, question: 'what can you do', answer: 'You can train me to answer questions by clicking the "Train Bot" button.' }
        ];

        let trainingData = JSON.parse(localStorage.getItem(STORAGE_KEY)) || defaultData;
        let chatHistory = JSON.parse(localStorage.getItem(CHAT_KEY)) || [];

        // --- DOM Elements ---
        const chatContainer = document.getElementById('chatContainer');
        const userInput = document.getElementById('userInput');
        const sendBtn = document.getElementById('sendBtn');
        const botNameDisplay = document.getElementById('botNameDisplay');
        const themeToggle = document.getElementById('themeToggle');
        const clearChatBtn = document.getElementById('clearChatBtn');
        
        // Modal Elements
        const trainModal = document.getElementById('trainModal');
        const openTrainBtn = document.getElementById('openTrainBtn');
        const closeTrainBtn = document.getElementById('closeTrainBtn');
        const closeTrainBtnFooter = document.getElementById('closeTrainBtnFooter');
        const trainQuestion = document.getElementById('trainQuestion');
        const trainAnswer = document.getElementById('trainAnswer');
        const addPairBtn = document.getElementById('addPairBtn');
        const trainingList = document.getElementById('trainingList');
        const knowledgeCount = document.getElementById('knowledgeCount');
        const exportBtn = document.getElementById('exportBtn');
        const importFile = document.getElementById('importFile');

        // --- Initialization ---
        document.addEventListener('DOMContentLoaded', () => {
            loadTheme();
            renderChatHistory();
            renderTrainingList();
            scrollToBottom();
            
            // Focus input on load
            userInput.focus();
        });

        // --- Theme Handling ---
        function loadTheme() {
            const theme = localStorage.getItem(THEME_KEY) || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        }

        themeToggle.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem(THEME_KEY, next);
        });

        // --- Chat Interaction ---
        sendBtn.addEventListener('click', handleUserMessage);
        userInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') handleUserMessage();
        });

        function handleUserMessage() {
            const text = userInput.value.trim();
            if (!text) return;

            // 1. Add User Message
            addMessage('user', text);
            userInput.value = '';

            // 2. Show Typing Indicator
            showTypingIndicator();

            // 3. Process Bot Response (Simulate delay for realism)
            setTimeout(() => {
                removeTypingIndicator();
                const response = generateResponse(text);
                addMessage('bot', response.text, response.confidence);
            }, 800 + Math.random() * 500); // Random delay between 800ms and 1300ms
        }

        function addMessage(sender, text, confidence = null) {
            const msgDiv = document.createElement('div');
            msgDiv.className = `message ${sender}`;
            
            const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            
            let confidenceHtml = '';
            if (confidence !== null && sender === 'bot') {
                confidenceHtml = `<div class="confidence-badge" title="Confidence Score">${Math.round(confidence * 100)}% Match</div>`;
            }

            const avatarHtml = sender === 'bot' 
                ? `<div class="bot-avatar" style="width:30px; height:30px; font-size:0.8rem; flex-shrink:0;">AI</div>` 
                : '';

            msgDiv.innerHTML = `
                ${avatarHtml}
                <div>
                    <div class="bubble">${escapeHtml(text)}${confidenceHtml}</div>
                    <div class="meta">${time}</div>
                </div>
            `;

            chatContainer.appendChild(msgDiv);
            saveToHistory(sender, text);
            scrollToBottom();
        }

        function showTypingIndicator() {
            const typingDiv = document.createElement('div');
            typingDiv.className = 'message bot typing-message';
            typingDiv.id = 'typingIndicator';
            typingDiv.innerHTML = `
                <div class="bot-avatar" style="width:30px; height:30px; font-size:0.8rem;">AI</div>
                <div class="bubble">
                    <div class="typing-indicator">
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                        <div class="typing-dot"></div>
                    </div>
                </div>
            `;
            chatContainer.appendChild(typingDiv);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typingIndicator');
            if (indicator) indicator.remove();
        }

        function scrollToBottom() {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        // --- Chatbot Logic (Brain) ---
        
        /**
         * Core Algorithm to find the best response.
         * 1. Exact Match (ignoring case and punctuation).
         * 2. Keyword Matching (Jaccard Similarity).
         * 3. Fallback.
         */
        function generateResponse(input) {
            const normalizedInput = normalizeText(input);
            let bestMatch = null;
            let highestScore = 0;

            // Step 1: Check for Exact Match
            const exactMatch = trainingData.find(item => normalizeText(item.question) === normalizedInput);
            if (exactMatch) {
                return { text: exactMatch.answer, confidence: 1.0 };
            }

            // Step 2: Fuzzy / Keyword Matching
            // We split input into tokens (words) and compare overlap
            const inputTokens = tokenize(normalizedInput);

            trainingData.forEach(item => {
                const itemTokens = tokenize(normalizeText(item.question));
                const score = calculateJaccardIndex(inputTokens, itemTokens);
                
                if (score > highestScore) {
                    highestScore = score;
                    bestMatch = item;
                }
            });

            // Threshold for fuzzy match (e.g., at least 40% similarity)
            if (bestMatch && highestScore > 0.4) {
                return { text: bestMatch.answer, confidence: highestScore };
            }

            // Step 3: Fallback
            return { 
                text: "I don't know that yet. Please train me with the correct answer!", 
                confidence: 0 
            };
        }

        // Helper: Normalize text (lowercase, remove punctuation)
        function normalizeText(text) {
            return text.toLowerCase().replace(/[^\w\s]/gi, '').trim();
        }

        // Helper: Split into words
        function tokenize(text) {
            return text.split(/\s+/).filter(w => w.length > 0);
        }

        // Helper: Jaccard Similarity (Intersection over Union)
        // Returns a value between 0.0 and 1.0
        function calculateJaccardIndex(tokensA, tokensB) {
            const setA = new Set(tokensA);
            const setB = new Set(tokensB);
            
            const intersection = new Set([...setA].filter(x => setB.has(x)));
            const union = new Set([...setA, ...setB]);
            
            if (union.size === 0) return 0;
            return intersection.size / union.size;
        }

        // --- History & Storage ---
        function saveToHistory(sender, text) {
            const msg = { sender, text, timestamp: Date.now() };
            chatHistory.push(msg);
            // Limit history to last 50 messages
            if (chatHistory.length > 50) chatHistory.shift();
            localStorage.setItem(CHAT_KEY, JSON.stringify(chatHistory));
        }

        function renderChatHistory() {
            // We don't re-render everything to keep animations smooth on new messages,
            // but we use this to restore state on refresh.
            // Note: We clear the default message if history exists.
            if (chatHistory.length > 0) {
                chatContainer.innerHTML = ''; 
                chatHistory.forEach(msg => {
                    // Re-render without animation for history
                    const msgDiv = document.createElement('div');
                    msgDiv.className = `message ${msg.sender}`;
                    msgDiv.style.opacity = '1';
                    msgDiv.style.transform = 'none';
                    
                    const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    const avatarHtml = msg.sender === 'bot' 
                        ? `<div class="bot-avatar" style="width:30px; height:30px; font-size:0.8rem; flex-shrink:0;">AI</div>` 
                        : '';
                    
                    msgDiv.innerHTML = `
                        ${avatarHtml}
                        <div>
                            <div class="bubble">${escapeHtml(msg.text)}</div>
                            <div class="meta">${time}</div>
                        </div>
                    `;
                    chatContainer.appendChild(msgDiv);
                });
            }
        }

        clearChatBtn.addEventListener('click', () => {
            if(confirm("Are you sure you want to clear the chat history?")) {
                chatHistory = [];
                localStorage.removeItem(CHAT_KEY);
                chatContainer.innerHTML = '';
                // Add greeting back
                addMessage('bot', 'Chat history cleared. Ready to start anew!');
            }
        });

        // --- Training Modal Logic ---
        openTrainBtn.addEventListener('click', () => {
            renderTrainingList();
            trainModal.classList.add('active');
        });

        const closeModal = () => {
            trainModal.classList.remove('active');
            trainQuestion.value = '';
            trainAnswer.value = '';
        };

        closeTrainBtn.addEventListener('click', closeModal);
        closeTrainBtnFooter.addEventListener('click', closeModal);

        // Close modal on outside click
        trainModal.addEventListener('click', (e) => {
            if (e.target === trainModal) closeModal();
        });

        addPairBtn.addEventListener('click', () => {
            const q = trainQuestion.value.trim();
            const a = trainAnswer.value.trim();

            if (!q || !a) {
                showToast('Please provide both a question and an answer.', 'error');
                return;
            }

            const newItem = {
                id: Date.now(),
                question: q,
                answer: a
            };

            trainingData.push(newItem);
            saveData();
            renderTrainingList();
            
            trainQuestion.value = '';
            trainAnswer.value = '';
            trainQuestion.focus();
            showToast('Training data added successfully!', 'success');
        });

        function renderTrainingList() {
            knowledgeCount.textContent = trainingData.length;
            trainingList.innerHTML = '';

            if (trainingData.length === 0) {
                trainingList.innerHTML = '<div class="empty-state">No training data yet.</div>';
                return;
            }

            trainingData.forEach(item => {
                const div = document.createElement('div');
                div.className = 'training-item';
                div.innerHTML = `
                    <div class="training-content">
                        <div class="training-q">${escapeHtml(item.question)}</div>
                        <div class="training-a">${escapeHtml(item.answer)}</div>
                    </div>
                    <div class="item-actions">
                        <button class="btn-secondary btn-small" onclick="editItem(${item.id})">Edit</button>
                        <button class="btn-secondary btn-small" style="color:var(--danger-color); border-color:var(--danger-color);" onclick="deleteItem(${item.id})">✕</button>
                    </div>
                `;
                trainingList.appendChild(div);
            });
        }

        // Exposed globally for inline onclick handlers
        window.deleteItem = function(id) {
            if(confirm('Delete this training pair?')) {
                trainingData = trainingData.filter(item => item.id !== id);
                saveData();
                renderTrainingList();
                showToast('Item deleted.', 'success');
            }
        };

        window.editItem = function(id) {
            const item = trainingData.find(i => i.id === id);
            if (!item) return;

            // Populate inputs
            trainQuestion.value = item.question;
            trainAnswer.value = item.answer;

            // Remove old item temporarily (it will be re-added on save)
            // A cleaner UX would just update the ID in the save logic, 
            // but for simplicity, we ask user to "Update" which essentially adds new and removes old
            // Or we can change the add button logic.
            // Here, let's implement a seamless Update:
            
            // Remove existing
            trainingData = trainingData.filter(i => i.id !== id);
            renderTrainingList();
            
            // Visual feedback
            addPairBtn.textContent = 'Update Entry';
            // Reset button text after one interaction or keep it simple?
            // Let's revert button text on next click or close.
            const originalHandler = addPairBtn.onclick;
            
            // Override handler temporarily
            const newHandler = () => {
                const q = trainQuestion.value.trim();
                const a = trainAnswer.value.trim();
                if(q && a) {
                    trainingData.push({ id: id, question: q, answer: a });
                    saveData();
                    renderTrainingList();
                    trainQuestion.value = '';
                    trainAnswer.value = '';
                    addPairBtn.textContent = 'Add Training Data';
                    addPairBtn.onclick = null; // Remove override
                    showToast('Item updated.', 'success');
                }
            };
            
            addPairBtn.onclick = newHandler;
        };

        function saveData() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(trainingData));
        }

        // --- Export/Import ---
        exportBtn.addEventListener('click', () => {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(trainingData, null, 2));
            const downloadAnchorNode = document.createElement('a');
            downloadAnchorNode.setAttribute("href", dataStr);
            downloadAnchorNode.setAttribute("download", "neurochat_training_data.json");
            document.body.appendChild(downloadAnchorNode);
            downloadAnchorNode.click();
            downloadAnchorNode.remove();
        });

        importFile.addEventListener('change', (event) => {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const importedData = JSON.parse(e.target.result);
                    if (Array.isArray(importedData)) {
                        // Merge strategies: Overwrite or Append? Let's Append.
                        trainingData = [...trainingData, ...importedData];
                        // Deduplicate by ID
                        trainingData = Array.from(new Map(trainingData.map(item => [item.id, item])).values());
                        saveData();
                        renderTrainingList();
                        showToast('Training data imported successfully!', 'success');
                    } else {
                        throw new Error('Invalid format');
                    }
                } catch (err) {
                    showToast('Error importing JSON file. Please check format.', 'error');
                    console.error(err);
                }
                // Clear input so same file can be selected again if needed
                importFile.value = '';
            };
            reader.readAsText(file);
        });

        // --- Utilities ---
        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.textContent = message;
            
            if (type === 'error') toast.style.borderLeftColor = 'var(--danger-color)';
            if (type === 'success') toast.style.borderLeftColor = 'var(--success-color)';

            document.getElementById('toastContainer').appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

    </script>
</body>
</html>
